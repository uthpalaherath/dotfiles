{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",
    "theme": "gruvbox",
    "permission": {
        "edit": "ask",
        "bash": "allow",
        "webfetch": "allow"
    },
    "provider": {
        "openai": {
          "options": {
            "baseURL": "https://litellm.oit.duke.edu/v1",
            "apiKey": "xxx"
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "{env:OLLAMA_HOST}/v1"
            },
            "models": {
                "qwen3.6": {},
                "qwen3-coder-next": {}
            }
        },
        "vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "vLLM (local)",
            "options": {
                "baseURL": "{env:VLLM_HOST}/v1"
            },
            "models": {
                "local-vllm": {}
            }
        }
    }
}
