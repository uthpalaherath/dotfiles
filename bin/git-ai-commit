#!/usr/bin/env bash
# Draft a commit message for the staged changes with Claude or Codex, show it,
# and ask whether to commit as is, edit it in $EDITOR, regenerate, or abort.
# Remaining args go to git commit (e.g., --no-verify).
#   git ai-commit [-b claude|codex] [-m model] [--] [git-commit args]
# GIT_AI_COMMIT_BACKEND and GIT_AI_COMMIT_MODEL override the defaults below.
set -euo pipefail

default_backend=codex
claude_model=sonnet
codex_model=gpt-6-sol

backend=${GIT_AI_COMMIT_BACKEND:-$default_backend}
model=${GIT_AI_COMMIT_MODEL:-}
while (( $# )); do
    case $1 in
        -b|--backend) backend=${2:?}; shift 2 ;;
        -m|--model) model=${2:?}; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
case $backend in
    claude) name=Claude; model=${model:-$claude_model} ;;
    codex) name=Codex; model=${model:-$codex_model} ;;
    *) echo "git-ai-commit: unknown backend '$backend' (claude or codex)" >&2; exit 2 ;;
esac
max_chars=60000

git rev-parse --git-dir >/dev/null
if git diff --cached --quiet; then
    echo "git-ai-commit: nothing staged" >&2
    exit 1
fi

prompt='You write git commit messages. The input has recent commit subjects from
this repo (for style), a diffstat, and the staged diff. Output ONLY the commit
message, no code fences, no preamble.
- Subject: imperative mood, capitalized, no trailing period, at most 72 chars.
  Name what changed concretely. No conventional-commit prefixes (feat:, fix:).
- Add a body only if the change has several distinct parts or a non-obvious
  reason. Then: blank line, short "- " bullets wrapped at 72 chars.
- Plain ASCII. No em or en dashes.'

diff=$(git diff --cached --no-color --no-ext-diff --diff-algorithm=minimal)
if (( ${#diff} > max_chars )); then
    diff="${diff:0:max_chars}
[diff truncated]"
fi

context() {
    echo "## Recent subjects"
    git log -n 10 --format=%s 2>/dev/null || true
    echo; echo "## Diffstat"
    git diff --cached --stat
    echo; echo "## Diff"
    printf '%s\n' "$diff"
}

generate() {
    echo "Generating commit message with $name ($model)..." >&2
    case $backend in
        claude)
            context | claude -p --model "$model" --tools "" \
                --no-session-persistence --system-prompt "$prompt" \
                2>"$errfile" | sed '/^```/d' ;;
        codex)
            # codex exec has no system prompt flag. The instructions go in as
            # the prompt and the context is appended as a <stdin> block. Only
            # the final message (-o) is kept, since stdout carries progress.
            context | codex exec -m "$model" -s read-only \
                --ephemeral --skip-git-repo-check --color never \
                -o "$outfile" "$prompt" >/dev/null 2>"$errfile" &&
                sed '/^```/d' "$outfile" ;;
    esac
}

msgfile=$(mktemp "${TMPDIR:-/tmp}/git-ai-commit.XXXXXX")
errfile=$(mktemp "${TMPDIR:-/tmp}/git-ai-commit-err.XXXXXX")
outfile=$(mktemp "${TMPDIR:-/tmp}/git-ai-commit-out.XXXXXX")
trap 'rm -f "$msgfile" "$errfile" "$outfile"' EXIT

while true; do
    msg=$(generate) || {
        status=$?
        echo "git-ai-commit: $backend failed (exit $status):" >&2
        cat "$errfile" >&2
        exit "$status"
    }
    if [[ -z ${msg//[[:space:]]/} ]]; then
        echo "git-ai-commit: $name returned nothing" >&2
        exit 1
    fi
    printf '%s\n' "$msg" >"$msgfile"

    printf '\n%s\n\n' "$msg"
    # A parent TUI (lazygit) can leave the tty raw with stray bytes queued,
    # e.g., terminal replies to its escape sequences. Restore cooked mode,
    # drain them, and require an explicit answer instead of defaulting to yes.
    # min 0 time 0 makes reads non-blocking, so cat drains and hits EOF;
    # this avoids fractional read -t, which macOS bash 3.2 lacks.
    if stty -icanon -echo min 0 time 0 </dev/tty 2>/dev/null; then
        cat </dev/tty >/dev/null
    fi
    stty sane </dev/tty 2>/dev/null || true
    ans=
    until [[ $ans =~ ^[YyEeRrQq] ]]; do
        read -r -p "Commit? [y]es / [e]dit / [r]egenerate / [q]uit: " ans </dev/tty || ans=q
    done
    case $ans in
        [Yy]*) git commit -F "$msgfile" "$@"; exit ;;
        [Ee]*) git commit -e -F "$msgfile" "$@"; exit ;;
        [Rr]*) continue ;;
        *) echo "Aborted." >&2; exit 1 ;;
    esac
done
