#!/usr/bin/env bash
# Draft a commit message for the staged changes with Claude, then open it in
# $EDITOR via `git commit -e`. Extra args go to git commit (e.g., --no-verify).
#   git ai-commit [git-commit args]
# GIT_AI_COMMIT_MODEL picks the model (default: sonnet).
set -euo pipefail

model=${GIT_AI_COMMIT_MODEL:-sonnet}
max_chars=${GIT_AI_COMMIT_MAX_CHARS:-60000}

git rev-parse --git-dir >/dev/null
if git diff --cached --quiet; then
    echo "git-ai-commit: nothing staged" >&2
    exit 1
fi

prompt='You write git commit messages. The input has recent commit subjects from
this repo (for style), a diffstat, and the staged diff. Output ONLY the commit
message, no code fences, no preamble.
- Subject: imperative mood, capitalized, no trailing period, at most 72 chars.
  Name what changed concretely. No conventional-commit prefixes (feat:, fix:).
- Add a body only if the change has several distinct parts or a non-obvious
  reason. Then: blank line, short "- " bullets wrapped at 72 chars.
- Plain ASCII. No em or en dashes.'

diff=$(git diff --cached --no-color --no-ext-diff --diff-algorithm=minimal \
    -- . ':(exclude)*.lock' ':(exclude)package-lock.json')
if (( ${#diff} > max_chars )); then
    diff="${diff:0:max_chars}
[diff truncated]"
fi

echo "Generating commit message with Claude ($model)..." >&2
msg=$(
    {
        echo "## Recent subjects"
        git log -n 10 --format=%s 2>/dev/null || true
        echo; echo "## Diffstat"
        git diff --cached --stat
        echo; echo "## Diff"
        printf '%s\n' "$diff"
    } | claude -p --model "$model" --tools "" --no-session-persistence \
        --system-prompt "$prompt" 2>/dev/null
)
msg=$(printf '%s\n' "$msg" | sed '/^```/d')

if [[ -z ${msg//[[:space:]]/} ]]; then
    echo "git-ai-commit: Claude returned nothing" >&2
    exit 1
fi

msgfile=$(mktemp "${TMPDIR:-/tmp}/git-ai-commit.XXXXXX")
trap 'rm -f "$msgfile"' EXIT
printf '%s\n' "$msg" >"$msgfile"
git commit -e -F "$msgfile" "$@"
