""" ---------- PYTHON ----------

""" vim-python-docstring
let g:python_style = 'numpy'

""" vim-slime and vim-ipython-cell (mappings are local to Python buffers)
let g:slime_target = "vimterminal"
let g:slime_python_ipython = 1
let g:slime_dont_ask_default = 1
let g:ipython_cell_delimit_cells_by = "marks"

function! s:PythonMaps() abort
  " Start IPython in a vertical / horizontal split
  nnoremap <buffer> <Leader>S :vert term <CR> ipython --matplotlib<CR> <c-w><c-p> :SlimeConfig <CR>
  nnoremap <buffer> <Leader>s :term <CR> ipython --matplotlib<CR> <c-w><c-p> :SlimeConfig <CR>
  nnoremap <buffer> <Leader>r :IPythonCellRun<CR>
  nnoremap <buffer> <Leader>R :IPythonCellRunTime<CR>
  nnoremap <buffer> <Leader>c :IPythonCellExecuteCell<CR>
  nnoremap <buffer> <Leader>C :IPythonCellExecuteCellJump<CR>
  nnoremap <buffer> <Leader>l :IPythonCellClear<CR>
  nnoremap <buffer> <Leader>x :IPythonCellClose<CR>
  nnoremap <buffer> <Leader>qq :IPythonCellRestart<CR>
  " Send the current line or selection to IPython
  nmap <buffer> <Leader>h <Plug>SlimeLineSend
  xmap <buffer> <Leader>h <Plug>SlimeRegionSend
endfunction
autocmd vimrc FileType python call s:PythonMaps()

