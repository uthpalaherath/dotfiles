  \ if empty(<q-args>) | echo "USAGE: Rg PATTERN [OPTIONS] [PATH]" |
  \ else | call fzf#vim#grep(s:rg_grep . <q-args>, 1, fzf#vim#with_preview(s:rg_preview), <bang>0) | endif

