" ~/.vimrc
"
" Standalone Vim config.
" Plugins are managed by vim-plug and installed to ~/.vim/plugged.
" :PlugUpdate updates plugins, :PlugClean removes unlisted ones, :PlugUpgrade updates vim-plug.
"
" author: Uthpala Herath

set encoding=utf-8
scriptencoding utf-8

" All autocmds below join this group, so re-sourcing the file doesn't duplicate them.
augroup vimrc
  autocmd!
augroup END

""" Plugin Manager
" Plugins load only at startup: re-sourcing this file re-applies settings without
" reloading plugins (vim-smoothie and vim-pencil error when loaded twice).
" After adding or removing a Plug line, restart Vim, then :PlugInstall / :PlugClean.
if has('vim_starting')
if empty(glob('~/.vim/autoload/plug.vim'))
  silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  autocmd vimrc VimEnter * PlugInstall --sync | source $MYVIMRC
endif
call plug#begin('~/.vim/plugged')

